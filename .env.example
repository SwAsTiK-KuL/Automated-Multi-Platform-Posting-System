# Copy to .env and fill in. Platforms left blank are reported as "failed: Not configured".

REQUEST_TIMEOUT=15
TIMEZONE=Asia/Kolkata

# 1. Telegraph – optional; leave blank and an account is created automatically
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_AUTHOR_NAME=Automated Poster

# 2. Mastodon – Preferences > Development > New application (scope: write:statuses)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# 3. Bluesky – Settings > Privacy and security > App passwords
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social

# 4. Telegram – create a bot with @BotFather, add it as admin of a PUBLIC channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_channel_username

# 5. Discord – Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=
DISCORD_GUILD_ID=

# 6. GitHub Gist – Settings > Developer settings > Personal access tokens (scope: gist)
GITHUB_TOKEN=

# 7. Hugging Face (LLM platform) – huggingface.co/settings/tokens (write), repo you own
HUGGINGFACE_TOKEN=
HUGGINGFACE_REPO_ID=yourname/your-model
HUGGINGFACE_REPO_TYPE=model
